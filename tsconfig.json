{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": "app",
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@/shared/*": ["../shared/*"],
      "@/assets/*": ["../assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "./**/*.tsx",
    "./**/*.ts"
  ]
}
